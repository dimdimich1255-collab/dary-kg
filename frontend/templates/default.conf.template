server {
    listen 80;
    root /usr/share/nginx/html;

    # Запросы /api/... nginx пересылает в контейнер бэкенда
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        # Настоящий адрес посетителя для лимитов отзывов. Своё значение, а не присланное клиентом
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
