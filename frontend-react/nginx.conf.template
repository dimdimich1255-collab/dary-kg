server {
    listen 80;
    root /usr/share/nginx/html;

    # ${API_HOST} подставляется при старте: backend (Python) или backend-node (Node.js)
    location /api/ {
        proxy_pass http://${API_HOST}:8000;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
